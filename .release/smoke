// This transport models the public response shapes without contacting a service or running inference.
$intelligenceTransport = new class () implements Transport {
    public array $requests = [];

    public function send(string $method, string $url, array $headers, ?string $body, int $timeoutSeconds, int $maxResponseBytes): TransportResponse
    {
        $this->requests[] = [$method, parse_url($url, PHP_URL_PATH), $headers, $body === null ? null : json_decode($body, true, flags: JSON_THROW_ON_ERROR)];
        $id = '01k3k7qh0f8w2y7x4m6n9p1r3t';
        $data = match (count($this->requests)) {
            1 => ['profiles' => [['profile' => 'text-generation-v1']]],
            2 => ['instruction_set_id' => $id, 'revisions' => []],
            3 => ['instruction_revision_id' => $id, 'revision' => 1],
            4 => ['instruction_set_id' => $id, 'revisions' => [['instruction_revision_id' => $id]]],
            5, 6 => ['job_id' => $id, 'state' => 'processing', 'output' => null],
            7 => ['job_id' => $id, 'state' => 'ready', 'output' => ['asset_id' => $id, 'media_type' => 'application/vnd.egensolve.generated-text+json']],
            8 => ['job_id' => $id, 'state' => 'cancelling', 'output' => null],
            default => throw new RuntimeException('Unexpected Intelligence request.'),
        };

        return new TransportResponse(200, [], json_encode(['version' => 1, ...$data], JSON_THROW_ON_ERROR));
    }
};
