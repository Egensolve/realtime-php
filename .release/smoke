<?php

declare(strict_types=1);

require __DIR__.'/vendor/autoload.php';

use Egensolve\Realtime\Contracts\Artifacts\ArtifactsClient;
use Egensolve\Realtime\Contracts\Auth\ChannelAuthSigner;
use Egensolve\Realtime\Contracts\Auth\SocketId;
